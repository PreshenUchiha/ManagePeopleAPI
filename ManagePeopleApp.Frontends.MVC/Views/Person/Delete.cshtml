@model ManagePeople.Libraries.Shared.PersonModel

@{
    ViewData["Title"] = "Person Details";
}

<h1>Person Details</h1>

<table class="table table-bordered">
    <tr>
        <th>PersonId</th>
        <td>@Model.PersonId</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Surname</th>
        <td>@Model.Surname</td>
    </tr>
    <tr>
        <th>IdNumber</th>
        <td>@Model.IdNumber</td>
    </tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.PersonId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
