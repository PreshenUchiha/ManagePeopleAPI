{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level}] <{SourceContext}> {NewLine}TraceId: {TraceId} {NewLine}{Message:lj} {NewLine}{Exception}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "Path": "E:\\Logs\\ManagePeople\\ManagePeopleAPI\\ManagePeopleAPI-.txt",
          "RollingInterval": "Day",
          "OutputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level}] <{SourceContext}> {NewLine}TraceId: {TraceId} {NewLine}{Message:lj} {NewLine}{Exception}{NewLine}",
          "RetainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StandbyConnectDb": "#{ManagePeopleDb}#"
  },
  "StoredProcedures": {
    GetAllPersons        
    GetPersonById 
    InsertNewPerson 
    UpdatePersonById 
    DeletePersonById 

    GetAllAccounts 
    GetAccountById 
    InsertNewAccount 
    UpdateAccountById 
    DeleteAccountById 

    GetAllTransactions  
    GetTransactionById  
    InsertNewTransaction 
    UpdateTransactionById 
    DeleteTransactionById 
  },

  "EnableSwaggerUI": "#{EnableSwaggerUI}#",
  "Security": {
    "XApiKey": "#{XApiKey}#",
    "RequestHeader": "XApiKey"
  }
}
