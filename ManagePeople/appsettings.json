{

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ManagePeopleDb": "#{ManagePeopleDb}#"
  },
  "StoredProcedures": {
    "GetAllPersons": "[dbo].[GetAllPersons]",
    "GetPersonById": "[dbo].[GetPersonById]",
    "InsertNewPerson": "[dbo].[InsertNewPerson]",
    "UpdatePersonById": "[dbo].[UpdatePersonById]",
    "DeletePersonById": "[dbo].[DeletePersonById]",

    "GetAllAccounts": "[dbo].[GetAllAccounts]",
    "GetAccountById": "[dbo].[GetAccountById]",
    "InsertNewAccount": "[dbo].[InsertNewAccount]",
    "UpdateAccountById ": "[dbo].[UpdateAccountById]",
    "DeleteAccountById": "[dbo].[DeleteAccountById]",

    "GetAllTransactions": "[dbo].[GetAllTransactions]",
    "GetTransactionById": "[dbo].[GetTransactionById]",
    "InsertNewTransaction": "[dbo].[InsertNewTransaction]",
    "UpdateTransactionById": "[dbo].[UpdateTransactionById]",
    "DeleteTransactionById": "[dbo].[DeleteTransactionById]"
  },

  "EnableSwaggerUI": "#{EnableSwaggerUI}#",
  "Security": {
    "XApiKey": "#{XApiKey}#",
    "RequestHeader": "XApiKey"
  }
}
